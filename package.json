{
  "name": "use-tools",
  "version": "0.1.1",
  "private": true,
  "description": "桌面工具集合体：一个外壳 + 一堆即插即用的小工具",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "build:debug": "cargo build --manifest-path src-tauri/Cargo.toml",
    "build:release": "cargo build --release --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "npm run test:unit && npm run test:rust",
    "test:unit": "node test/unit/xlsx.test.js",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "node test/run-e2e.js",
    "test:e2e:release": "node test/run-e2e.js --release",
    "test:all": "npm run test && npm run test:e2e",
    "check": "npm run fmt:check && npm run test && npm run test:e2e",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "package": "node scripts/package.js",
    "clean": "node scripts/clean.js",
    "clean:build": "node scripts/clean.js --build",
    "clean:all": "node scripts/clean.js --all"
  },
  "keywords": [
    "desktop",
    "toolbox",
    "tauri"
  ],
  "license": "MIT",
  "author": "cwh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwh-1214/use-tools.git"
  },
  "homepage": "https://github.com/cwh-1214/use-tools#readme",
  "bugs": {
    "url": "https://github.com/cwh-1214/use-tools/issues"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
